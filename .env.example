# Copy this file to .env and fill in the blanks. Never commit .env.
# Every value below except the API keys matches docker-compose.yml, so local dev works as-is.

NODE_ENV=development
LOG_LEVEL=info
# Set to "json" to force structured JSON logs (always JSON when NODE_ENV=production)
LOG_FORMAT=pretty

# ---------- API ----------
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional (defaults shown)
# JWT_EXPIRES_IN_DAYS=7
# BCRYPT_ROUNDS=12
# AUTH_RATE_LIMIT=20          # login/register attempts per IP per 15 min
# MAX_MONITORS_PER_USER=20
# TRUST_PROXY=0               # number of reverse proxies in front of the API (production)
# AI_RATE_LIMIT=30            # AI filter suggestions per user per hour

# ---------- Scheduler (optional, defaults shown) ----------
# SCHEDULER_TICK_MS=2000          # how often to look for due monitors
# SCHEDULER_BATCH_SIZE=200        # monitors per tick
# SCHEDULER_LEASE_TTL_MS=15000    # a crashed instance's partitions are taken over after this
# SCHEDULER_LEASE_RENEW_MS=5000   # must be under half the TTL
# OUTBOX_POLL_MS=1000

# ---------- Fetch workers (optional, defaults shown) ----------
# FETCH_TIMEOUT_MS=15000           # whole fetch incl. redirects
# FETCH_MAX_BYTES=5242880          # 5 MB, measured after decompression
# FETCH_USER_AGENT=MonitorlyBot/1.0   # add a contact URL if you run this publicly: "MonitorlyBot/1.0 (+https://…)"
# RESPECT_ROBOTS_TXT=true
# MONITOR_ERROR_THRESHOLD=5        # failed checks in a row before a monitor is set to "error"
# BROWSER_WORKER_PREFETCH=2        # pages rendered at once (Chromium is heavy)
# BROWSER_NAV_TIMEOUT_MS=30000
# BROWSER_SETTLE_MS=3000           # extra wait for JavaScript pages to finish loading

# ---------- Processing worker (optional, defaults shown) ----------
# PROCESSING_WORKER_PREFETCH=4
# REBASELINE_AFTER=3               # incomplete-looking checks in a row before a new page layout is accepted

# ---------- MongoDB (single-node replica set, so transactions work) ----------
MONGODB_URI=mongodb://localhost:27017/monitorly?directConnection=true

# ---------- RabbitMQ (management UI: http://localhost:15672) ----------
RABBITMQ_URL=amqp://monitorly:monitorly@localhost:5672

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Object storage (S3-compatible; SeaweedFS locally) ----------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=monitorly-snapshots
S3_ACCESS_KEY_ID=monitorly
S3_SECRET_ACCESS_KEY=monitorly-secret
S3_FORCE_PATH_STYLE=true

# ---------- Email ----------
# Local: emails go to Mailpit (http://localhost:8025). Set RESEND_API_KEY to send real email.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=                        # for a real SMTP server
# SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=Monitorly <onboarding@resend.dev>
# EMAIL_MAX_PER_HOUR=20            # per user; further alerts still appear in the app
# NOTIFICATION_WORKER_PREFETCH=10
# EMAIL_WORKER_PREFETCH=4

# ---------- AI ----------
# Turns a monitor's plain-English description into filters, and reviews changes that pass the
# filters (relevance + a one-line summary). Optional: without a key, users fill in the filters
# themselves and the filters alone decide what alerts. Try it with: npm run ai:try -- "your description"
#
#   gemini  free tier — key from https://aistudio.google.com/apikey
#   openai  paid      — key from https://platform.openai.com/api-keys
#   ollama  free, runs on your PC — https://ollama.com, then `ollama pull llama3.2` (no key)
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides (defaults depend on the provider)
# AI_MODEL=                     # gemini: gemini-flash-lite-latest, openai: gpt-5.4-mini, ollama: llama3.2
# AI_BASE_URL=                  # only for a proxy or another OpenAI-compatible service
# AI_REASONING_EFFORT=low       # off | none | minimal | low | medium | high
# AI_TIMEOUT_MS=30000
# Change review (rules + AI workers)
# AI_BATCH_SIZE=10                 # changes reviewed per AI call
# AI_REVIEW_DAILY_LIMIT=100        # AI review calls per user per day (then the filters alone decide)
# AI_REVIEW_GLOBAL_DAILY_LIMIT=500 # for the whole installation (protects the free-tier quota)
# AI_MIN_INTERVAL_MS=4000          # spacing between calls (free tiers allow ~15/minute)
# RULES_WORKER_PREFETCH=8
# AI_WORKER_PREFETCH=1
